# LiteLLM
LITELLM_BASE_URL=http://localhost:4000
AUDITOR_MODEL=glm-5
EXECUTOR_MODEL=mimo-v2-flash

# Storage
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql://autopwn:autopwn@localhost:5432/autopwn
CHROMA_PATH=./data/chroma

# Optional API keys for recon
SHODAN_API_KEY=
CENSYS_API_KEY=

# Safety
MAX_ITERATIONS=50
TOOL_TIMEOUT=60
REQUIRE_SCOPE_CONFIRMATION=true

# Verification
VERIFICATION_CONFIDENCE_THRESHOLD=0.7
VERIFICATION_REPRODUCIBILITY_RUNS=3
VERIFICATION_REQUIRED_SUCCESSES=2

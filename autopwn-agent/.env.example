# AutoPwn Agent — Environment Configuration
# Target site: pigi.in

# --- Target ---
TARGET_HOST=pigi.in
TARGET_URL=https://pigi.in
SESSION_NAME=pigi-in-recon

# --- Scope (pigi.in) ---
SCOPE_DOMAINS=pigi.in,*.pigi.in
SCOPE_PORTS=80,443,8080,8443
SCOPE_PATHS=/

# --- LLM (via LiteLLM) ---
LITELLM_BASE_URL=http://localhost:4000
AUDITOR_MODEL=openai/gpt-4o
EXECUTOR_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key-here

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
SESSION_TTL=86400

# --- PostgreSQL ---
DATABASE_URL=postgresql://autopwn:autopwn@localhost:5432/autopwn

# --- ChromaDB ---
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# --- Agent tuning ---
MAX_ITERATIONS=10
CONFIDENCE_THRESHOLD=0.7
REPRODUCIBILITY_RUNS=3
REQUEST_TIMEOUT=30

# --- Safety ---
DRY_RUN=false
SAFE_MODE=true
